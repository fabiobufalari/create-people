<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Adiciona o Spring Boot Parent POM -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.5</version> <!-- Versão do Spring Boot -->
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.bufalari</groupId>
	<artifactId>create-people</artifactId>
	<version>0.0.1-SNAPSHOT</version> <!-- Versão do seu projeto -->
	<name>create-people</name>
	<description>Microservice for managing people</description>

	<properties>
		<!-- Java version continua aqui -->
		<java.version>17</java.version>
		<!-- Versão do Spring Cloud gerenciada no dependencyManagement -->
		<spring-cloud.version>2023.0.1</spring-cloud.version>
		<!-- Versão do SpringDoc (não gerenciada pelo parent do Boot) -->
		<springdoc-openapi.version>2.5.0</springdoc-openapi.version>
		<!-- Versão do JJWT (não gerenciada pelo parent do Boot) -->
		<jjwt.version>0.11.5</jjwt.version> <!-- Recomendo usar uma versão mais recente do jjwt -->

	</properties>

	<dependencies>
		<!-- Spring Boot Starters (sem versão, gerenciadas pelo parent) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId> <!-- Adicionado para health check -->
		</dependency>

		<!-- PostgreSQL (sem versão, gerenciada pelo parent) -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Lombok (sem versão, gerenciada pelo parent) -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- Swagger/OpenAPI (versão explícita via propriedade) -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc-openapi.version}</version>
		</dependency>

		<!-- Feign Client (sem versão, gerenciada pelo spring-cloud-dependencies BOM) -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-openfeign</artifactId>
		</dependency>

		<!-- JWT - Recomendo usar as dependências mais recentes -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId> <!-- API -->
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId> <!-- Implementação Runtime -->
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId> <!-- Jackson support -->
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- SLF4J API (geralmente gerenciado pelo parent, não precisa explícito) -->
		<!--
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        -->
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<!-- Importa o BOM do Spring Cloud para gerenciar versões do cloud -->
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<!-- Versão é gerenciada pelo parent, não precisa aqui -->
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>